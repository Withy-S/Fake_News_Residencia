FN_MIN_TEXT_LENGTH=20
FN_MIN_CONFIDENCE=0.6
FN_CLASSIFIER=stacking
FN_STACKING_MODEL_PATH=models/stacking.joblib
FN_FALLBACK_METHOD=ai_fallback
FN_TRUSTED_DOMAINS=[]
FN_REQUEST_TIMEOUT_SECONDS=10
FN_ALLOWED_ORIGINS=[]
