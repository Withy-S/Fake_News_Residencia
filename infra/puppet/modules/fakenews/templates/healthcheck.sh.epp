<%- | String $url, Integer $max_failures | -%>
#!/bin/sh
# Gerenciado pelo Puppet (infra/puppet). Chamado pelo fakenews-healthcheck.timer.
# Reinicia a stack depois de <%= $max_failures %> falhas seguidas do /health.
STATE=/run/fakenews-healthcheck.failures

# Durante start/reload (build da imagem) a API fica fora do ar de propósito.
[ "$(systemctl is-active fakenews)" = "active" ] || exit 0

if curl -fsS --max-time 5 "<%= $url %>" >/dev/null 2>&1; then
  rm -f "$STATE"
  exit 0
fi

failures=$(( $(cat "$STATE" 2>/dev/null || echo 0) + 1 ))
echo "$failures" > "$STATE"
logger -t fakenews-healthcheck "API sem resposta (falha ${failures}/<%= $max_failures %>)"

if [ "$failures" -ge <%= $max_failures %> ]; then
  logger -t fakenews-healthcheck "Reiniciando a stack"
  rm -f "$STATE"
  systemctl restart fakenews
fi
