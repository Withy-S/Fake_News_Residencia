{
  "title": "Fake News API",
  "uid": "fake-news-api",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "API no ar",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "up{job=\"fakenews-api\"}", "legendFormat": "up" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "FORA DO AR", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "NO AR", "color": "green" } } }
          ]
        }
      }
    },
    {
      "id": 2,
      "title": "Requisições por status (taxa, 5min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_requests_total{job=\"fakenews-api\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Latência p95 por rota",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, handler) (rate(http_request_duration_seconds_bucket{job=\"fakenews-api\"}[5m])))",
          "legendFormat": "{{handler}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Classificações por tipo (/analyze)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by (classification) (increase(fn_classifications_total{job=\"fakenews-api\"}[15m]))",
          "legendFormat": "{{classification}}"
        }
      ],
      "description": "Se a proporção de 'suspeito' disparar ou ficar perto de 100%, é sinal de deriva do modelo (foi assim que o bug de pré-processamento de 2026-10-12 teria aparecido aqui em vez de só no teste manual)."
    },
    {
      "id": 5,
      "title": "Confiança média por método",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "sum by (method) (rate(fn_confidence_sum{job=\"fakenews-api\"}[15m])) / sum by (method) (rate(fn_confidence_count{job=\"fakenews-api\"}[15m]))",
          "legendFormat": "{{method}}"
        }
      ]
    }
  ]
}
